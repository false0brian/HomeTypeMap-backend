FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app

EXPOSE 8000
CMD ["bash", "-lc", "alembic upgrade head && python scripts/seed_mvp.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
